// Cloudflare Workers static-assets hosting for niuexa.ai.
// _site is built by build/package-pages.mjs + build/package-cloudflare.mjs; see
// .github/workflows/github-pages.yml. There is no Worker script: every request
// is answered from the uploaded files, _redirects and _headers.
{
  "name": "niuexa-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./_site",
    // Serve exact paths so the canonical .html URLs never redirect; the URL
    // shapes GitHub Pages resolved implicitly are generated into _redirects.
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true,
  // niuexa.ai is served by this Worker. Deploying from CI attaches the Custom
  // Domain; wrangler runs non-interactively there, so it replaces the GitHub
  // Pages A records in the same API call (no moment without a DNS record).
  // While any Custom Domain is listed, this list is the Worker's complete set:
  // a domain dropped from it is detached. www.niuexa.ai is not listed: a
  // Cloudflare Redirect Rule sends it to https://niuexa.ai with path and query.
  "routes": [
    { "pattern": "niuexa.ai", "custom_domain": true }
  ]
}
