// Cloudflare Workers static-assets hosting for niuexa.ai.
// _site is built by build/package-pages.mjs + build/package-cloudflare.mjs; see
// .github/workflows/github-pages.yml. There is no Worker script: every request
// is answered from the uploaded files, _redirects and _headers.
{
  "name": "niuexa-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./_site",
    // Serve exact paths so the canonical .html URLs never redirect; the URL
    // shapes GitHub Pages resolved implicitly are generated into _redirects.
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
  // niuexa.ai reaches this Worker through the route niuexa.ai/* on the proxied
  // niuexa.ai A records, both set in the Cloudflare dashboard; www.niuexa.ai is
  // a Cloudflare Redirect Rule to https://niuexa.ai. No routes are listed here
  // on purpose. Cloudflare refuses a Custom Domain on a hostname that already
  // has DNS records (error 100117, even with override_existing_dns_record; see
  // cloudflare/workers-sdk#9878), and deleting the records first would leave
  // niuexa.ai without an address. With no routes listed, wrangler deploy leaves
  // the dashboard route alone; a "routes" entry here would replace it.
}
